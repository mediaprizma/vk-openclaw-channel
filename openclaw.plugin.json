{
  "id": "vk-openclaw-channel",
  "channels": [
    "vk-openclaw-channel"
  ],
  "doctorContract": {
    "stateMigrations": []
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "vk-openclaw-channel": {
      "label": "VK",
      "description": "Канал OpenClaw для сообществ ВКонтакте через Bots Long Poll API.",
      "uiHints": {
        "systemPrompt": {
          "label": "System prompt",
          "help": "Trusted instructions injected into every VK turn.",
          "placeholder": "Instructions for the VK agent…",
          "advanced": false
        },
        "commentPromptTemplate": {
          "label": "VK comment prompt template",
          "help": "Template used for every VK wall, clip or video comment. Leave empty to use the built-in template.",
          "placeholder": "Источник обращения:\nВКонтакте → {{source_label}}\nАвтор VK ID: {{sender_id}}\nКомментарий ID: {{comment_id}}\n\nКомментарий клиента:\n{{comment_text}}\n\nИсходный контент: {{origin_type}}\nID: {{origin_id}}\nСсылка: {{origin_url}}\n{{origin_extra}}\n\nПравило ответа:\n{{response_rules}}",
          "advanced": false
        },
        "commentResponseRules": {
          "label": "VK comment response rules",
          "help": "Rules appended to every VK comment context under «Правило ответа». Leave empty to use the built-in rules.",
          "placeholder": "Если вопрос можно решить публично — отвечай в текущем комментарии.\nЕсли для расчёта или консультации нужны персональные детали, предложи клиенту написать в личные сообщения.\nНе утверждай, что можешь написать клиенту первым в личные сообщения, если это не подтверждено успешной доставкой.",
          "advanced": false
        },
        "accounts.*.systemPrompt": {
          "label": "Account system prompt",
          "help": "System prompt for this VK account. It overrides the channel-wide prompt.",
          "placeholder": "Instructions for this VK account…",
          "advanced": false
        },
        "groups.*.systemPrompt": {
          "label": "Group system prompt",
          "help": "Additional trusted instructions for this VK group.",
          "placeholder": "Instructions for this VK group…",
          "advanced": true
        }
      },
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "token": {
            "description": "Community access token, or a SecretRef { source, provider, id } the gateway resolves at startup.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "env"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "store"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "file"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^(?:value|(?:/(?:[^~/]|~[01])*)+)$"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "exec"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^(?!(?:[^/]*/)*\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._:/#-]{0,255}$"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            ]
          },
          "diagnostics": {
            "type": "object",
            "description": "Channel-wide diagnostics level. `openclaw config validate` reads this schema, so the level is typed here as well as in the zod schema.",
            "additionalProperties": false,
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "off",
                  "redacted",
                  "full"
                ]
              }
            }
          },
          "comments": {
            "type": "object",
            "description": "VK wall/video comment handling. Comment events reuse the customer's direct session while keeping a separate reply route to the public thread.",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enable comment events."
              },
              "postComments": {
                "type": "boolean",
                "description": "Handle comments on wall posts."
              },
              "clipComments": {
                "type": "boolean",
                "description": "Handle comments on VK Clips (short videos)."
              },
              "videoComments": {
                "type": "boolean",
                "description": "Handle comments on regular VK videos."
              }
            }
          },
          "contextVisibility": {
            "type": "string",
            "description": "Which shared context reaches the agent in groups: every forward and quote (`all`), only those from allowlisted authors (`allowlist`), or the same plus a quote of the bot's own message (`allowlist_quote`). Accepted per account too.",
            "enum": [
              "all",
              "allowlist",
              "allowlist_quote"
            ]
          },
          "systemPrompt": {
            "type": "string",
            "description": "Trusted system prompt injected into every VK turn. This is available channel-wide and can be overridden per account."
          },
          "commentPromptTemplate": {
            "type": "string",
            "description": "Template for the context sent to the agent when a VK wall, clip or video comment arrives. Supports {{source_label}}, {{sender_id}}, {{comment_id}}, {{comment_text}}, {{origin_type}}, {{origin_id}}, {{origin_url}}, {{origin_extra}} and {{response_rules}}."
          },
          "commentResponseRules": {
            "type": "string",
            "description": "Rules appended under «Правило ответа» for every VK comment. Leave empty to use the built-in rules."
          },
          "audio": {
            "type": "object",
            "description": "Channel-wide voice limits; `settings.ts` reads `channels.vk-openclaw-channel.audio` for every account, so they are not accepted per account. `openclaw config validate` reads this schema, so the limits are typed here as well as in the zod schema.",
            "additionalProperties": false,
            "properties": {
              "maxVoiceMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Hard cap for one voice message; VK rejects longer ones."
              },
              "splitDeadlineMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Deadline for the whole split operation."
              },
              "splitTimeoutMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Timeout for a single ffmpeg/ffprobe run."
              },
              "maxInputBytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Input files larger than this are not split at all."
              },
              "maxSegments": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Ceiling on segments: nobody listens to more voice messages than this."
              },
              "remoteMaxBytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Download ceiling for remote media; the URL comes from a model reply."
              }
            }
          },
          "streaming": {
            "type": "object",
            "description": "Channel-wide step-progress draft: with `mode: \"progress\"` the agent's execution steps are shown in one message edited in place, which then becomes the answer. Only the mode is typed here; the keys below it (`progress.label`, `progress.maxLines`, …) belong to the core draft renderer. Not accepted per account.",
            "additionalProperties": true,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "off",
                  "progress"
                ]
              }
            }
          },
          "accounts": {
            "type": "object",
            "description": "Per-account overrides. Diagnostics, voice limits and the step-progress draft are channel-wide; contextVisibility can be overridden here.",
            "additionalProperties": {
              "type": "object",
              "allOf": [
                {
                  "not": {
                    "required": [
                      "diagnostics"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "audio"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "streaming"
                    ]
                  }
                }
              ],
              "properties": {
                "token": {
                  "description": "Community access token, or a SecretRef { source, provider, id } the gateway resolves at startup.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "const": "env"
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                            }
                          },
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "const": "store"
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                            }
                          },
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "const": "file"
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string",
                              "pattern": "^(?:value|(?:/(?:[^~/]|~[01])*)+)$"
                            }
                          },
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string",
                              "const": "exec"
                            },
                            "provider": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                            },
                            "id": {
                              "type": "string",
                              "pattern": "^(?!(?:[^/]*/)*\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._:/#-]{0,255}$"
                            }
                          },
                          "required": [
                            "source",
                            "provider",
                            "id"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  ]
                },
                          "comments": {
            "type": "object",
            "description": "Per-account VK wall/video comment handling.",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "postComments": { "type": "boolean" },
              "clipComments": { "type": "boolean" },
              "videoComments": { "type": "boolean" }
            }
          },
"systemPrompt": {
                  "type": "string",
                  "description": "System prompt for this VK account. When set, it overrides the channel-wide system prompt."
                },
                "commentPromptTemplate": {
                  "type": "string",
                  "description": "Template for VK comment context for this account. Supports {{source_label}}, {{sender_id}}, {{comment_id}}, {{comment_text}}, {{origin_type}}, {{origin_id}}, {{origin_url}}, {{origin_extra}} and {{response_rules}}."
                },
                "commentResponseRules": {
                  "type": "string",
                  "description": "Rules appended under «Правило ответа» for every VK comment handled by this account."
                },
                "contextVisibility": {
                  "type": "string",
                  "description": "Overrides the channel-wide contextVisibility for this account.",
                  "enum": [
                    "all",
                    "allowlist",
                    "allowlist_quote"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "name": "VK OpenClaw Channel",
  "description": "Канал OpenClaw для сообществ ВКонтакте через Bots Long Poll API."
}
